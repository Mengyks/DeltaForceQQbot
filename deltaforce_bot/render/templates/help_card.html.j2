<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: #f2f3f5; }
  body {
    width: 1000px;
    height: 1450px;
    position: relative;
    font-family: "Microsoft YaHei", "Noto Sans CJK SC", "Source Han Sans SC", "WenQuanYi Zen Hei", "WenQuanYi Micro Hei", "PingFang SC", sans-serif;
    color: #20242b;
    -webkit-font-smoothing: antialiased;
    overflow: hidden;
  }
  .bg {
    position: absolute; inset: 0;
    background-color: #eceef3;
    background-position: center top;
    background-size: cover;
    background-repeat: no-repeat;
  }
  .bg.no-image {
    background:
      radial-gradient(900px 500px at 78% 4%, rgba(180, 130, 255, .35), transparent 62%),
      radial-gradient(700px 420px at 10% 96%, rgba(251, 114, 153, .22), transparent 65%),
      linear-gradient(150deg, #f8f7fb, #e8e9f0 58%, #dfe2ea);
  }
  .veil {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(245, 246, 248, .04) 0%, rgba(245, 246, 248, .04) 28%, rgba(245, 246, 248, .55) 58%, rgba(245, 246, 248, .92) 100%);
  }
  .page {
    position: relative;
    width: 1000px;
    height: 1450px;
    padding: 26px 32px 28px;
    display: flex;
    flex-direction: column;
  }
  header { display: flex; align-items: flex-start; justify-content: space-between; }
  .title-box {
    display: inline-block;
    max-width: 720px;
    padding: 14px 22px 13px;
    border-radius: 18px;
    background: rgba(255, 255, 255, .88);
    border: 1px solid rgba(255, 255, 255, .96);
    box-shadow: 0 10px 26px rgba(30, 25, 40, .10);
    backdrop-filter: blur(10px);
  }
  .eyebrow {
    font-size: 11px;
    line-height: 1;
    letter-spacing: 4px;
    color: #8b5cf6;
    font-weight: 800;
  }
  h1 {
    margin: 7px 0 0;
    font-size: 38px;
    line-height: 1.18;
    font-weight: 900;
    letter-spacing: 1.5px;
  }
  .subtitle {
    margin-top: 7px;
    font-size: 15px;
    color: #6f7683;
    letter-spacing: .4px;
  }
  .stamp {
    margin-top: 4px;
    padding: 8px 13px;
    border-radius: 999px;
    background: rgba(30, 27, 38, .72);
    color: #fff;
    font-size: 12px;
    letter-spacing: 2px;
    font-weight: 700;
    box-shadow: 0 8px 18px rgba(30, 25, 40, .18);
  }
  .panel {
    margin-top: auto;
    padding: 20px 22px 16px;
    border-radius: 24px;
    background: rgba(255, 255, 255, .93);
    border: 1px solid rgba(255, 255, 255, .98);
    box-shadow: 0 16px 36px rgba(30, 25, 40, .14);
    backdrop-filter: blur(12px);
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .feature {
    background: rgba(250, 250, 252, .94);
    border: 1px solid #ececf2;
    border-left: 5px solid #7a8794;
    border-radius: 14px;
    padding: 12px 14px 12px;
    min-height: 136px;
  }
  .feature.wide {
    grid-column: span 2;
    display: flex;
    align-items: center;
    gap: 18px;
    min-height: 104px;
  }
  .feature.wide .feature-head { margin-bottom: 0; flex: 0 0 auto; }
  .feature.wide .cmd { margin-top: 0; }
  .feature.wide .example { margin-top: 0; }
  .feature.wide .note { margin-top: 0; margin-left: auto; text-align: right; }
  .feature-head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }
  .feature-title {
    font-size: 21px;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: .5px;
  }
  .badge {
    font-size: 11px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: .6px;
    color: #707786;
    background: #f0f1f5;
    border-radius: 999px;
    padding: 3px 8px;
  }
  .cmd {
    margin-top: 6px;
    padding: 3px 7px;
    border-radius: 6px;
    background: #f3f4f8;
    font-family: "Consolas", "Cascadia Mono", "DejaVu Sans Mono", monospace;
    font-size: 15px;
    line-height: 1.35;
    font-weight: 700;
    color: #2b2f38;
    word-break: break-all;
  }
  .example {
    margin-top: 4px;
    font-size: 13px;
    line-height: 1.35;
    color: #7b8290;
    word-break: break-all;
  }
  .note {
    margin-top: 5px;
    font-size: 12.5px;
    line-height: 1.35;
    color: #9299a4;
  }
  footer {
    margin-top: 12px;
    padding-top: 9px;
    border-top: 1px solid #eceef3;
    text-align: center;
    font-size: 12.5px;
    letter-spacing: .4px;
    color: #8a929e;
  }
</style>
</head>
<body>
<div class="bg{% if not background_url %} no-image{% endif %}"{% if background_url %} style="background-image: url('{{ background_url }}')"{% endif %}></div>
<div class="veil"></div>
<div class="page">
  <header>
    <div class="title-box">
      <div class="eyebrow">HELP / COMMANDS</div>
      <h1>{{ title }}</h1>
      <div class="subtitle">{{ subtitle }}</div>
    </div>
    <div class="stamp">/帮助</div>
  </header>

  <main class="panel">
    <div class="grid">
      {% for section in sections %}
      <section class="feature{% if loop.last and (sections | length) % 2 == 1 %} wide{% endif %}" style="border-left-color: {{ section.accent }}{% if section.badge == '娱乐' %}; background: linear-gradient(90deg, {{ section.accent }}14, rgba(250, 250, 252, .94) 42%){% endif %}">
        <div class="feature-head">
          <span class="feature-title">{{ section.title }}</span>
          <span class="badge">{{ section.badge }}</span>
        </div>
        {% for command in section.commands %}
        <div class="cmd">{{ command.command }}</div>
        {% if command.example %}
        <div class="example">示例：{{ command.example }}</div>
        {% endif %}
        {% endfor %}
        {% if section.note %}
        <div class="note">{{ section.note }}</div>
        {% endif %}
      </section>
      {% endfor %}
    </div>
    <footer>{{ footer }}</footer>
  </main>
</div>
</body>
</html>
