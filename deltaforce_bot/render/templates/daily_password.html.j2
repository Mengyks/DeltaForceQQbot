<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: #080b10; }
  body {
    width: 1040px;
    font-family: "Microsoft YaHei", "Noto Sans CJK SC", "Source Han Sans SC", "WenQuanYi Zen Hei", "WenQuanYi Micro Hei", "PingFang SC", sans-serif;
    color: #eef3f8;
    -webkit-font-smoothing: antialiased;
  }
  .card {
    position: relative; overflow: hidden;
    padding: 34px 34px 26px;
    background:
      radial-gradient(1200px 520px at 12% -10%, rgba(229, 57, 53, .14), transparent 60%),
      radial-gradient(900px 520px at 100% 110%, rgba(255, 212, 121, .08), transparent 55%),
      #0b0f14;
  }
  .card::before {
    content: ""; position: absolute; top: 0; left: 0; right: 0; height: 4px;
    background: linear-gradient(90deg, #e53935, #ff8a65 40%, rgba(229, 57, 53, 0));
  }
  .grid {
    position: absolute; inset: 0; pointer-events: none; opacity: .5;
    background-image:
      linear-gradient(rgba(255, 255, 255, .025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, .025) 1px, transparent 1px);
    background-size: 44px 44px;
  }
  .content { position: relative; }

  header { margin-bottom: 22px; }
  .eyebrow { font-size: 13px; letter-spacing: 5px; color: #ffd479; font-weight: 700; }
  .title-row {
    display: flex; align-items: flex-end; justify-content: space-between; gap: 20px;
    margin-top: 8px;
  }
  h1 { margin: 0; font-size: 54px; line-height: 1; letter-spacing: 4px; font-weight: 800; }
  h1 .accent { color: #e53935; }
  .date-block { text-align: right; padding-bottom: 4px; }
  .date { font-size: 26px; font-weight: 700; letter-spacing: 2px; }
  .update { margin-top: 6px; font-size: 15px; color: #9fb0c3; }
  .meta {
    margin-top: 14px; display: flex; align-items: center; gap: 12px;
    font-size: 17px; color: #b7c5d4;
  }
  .meta .dot { width: 4px; height: 4px; border-radius: 50%; background: #5e7185; }
  .rule {
    height: 3px; margin-top: 18px;
    background: linear-gradient(90deg, #e53935 0%, rgba(229, 57, 53, .65) 32%, rgba(229, 57, 53, .08) 100%);
  }

  .rows { display: flex; flex-direction: column; gap: 12px; }
  .row {
    position: relative; height: 150px; border-radius: 12px; overflow: hidden;
    border: 1px solid rgba(255, 255, 255, .09);
    background: #121922;
    box-shadow: 0 8px 22px rgba(0, 0, 0, .28);
  }
  .row.no-bg { background: linear-gradient(135deg, #18212b, #0e141b); }
  .row .bg {
    position: absolute; inset: 0;
    background-size: cover; background-position: center 42%;
    opacity: .55; filter: saturate(.92) contrast(1.06);
    transform: scale(1.015);
  }
  .row .shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(5, 8, 12, .94) 0%, rgba(5, 8, 12, .70) 38%, rgba(5, 8, 12, .25) 66%, rgba(5, 8, 12, .86) 100%),
      linear-gradient(0deg, rgba(5, 8, 12, .45), transparent 45%);
  }
  .row .bar {
    position: absolute; left: 0; top: 22px; bottom: 22px; width: 4px;
    border-radius: 0 4px 4px 0; background: #e53935;
    box-shadow: 0 0 12px rgba(229, 57, 53, .55);
  }
  .index {
    position: absolute; left: 30px; top: 17px;
    font-size: 12px; letter-spacing: 3px; font-weight: 700;
    color: rgba(255, 212, 121, .8);
  }
  .info {
    position: absolute; left: 30px; top: 50%; transform: translateY(-50%);
    width: 570px;
  }
  .name {
    font-size: 38px; font-weight: 800; letter-spacing: 2px; line-height: 1.1;
    text-shadow: 0 2px 12px rgba(0, 0, 0, .9);
  }
  .location {
    margin-top: 9px; max-width: 560px;
    font-size: 17px; line-height: 1.45; color: #d2dde9;
    text-shadow: 0 2px 8px rgba(0, 0, 0, .9);
  }
  .location.empty { color: #7f8fa0; }

  .code-panel {
    position: absolute; right: 28px; top: 50%; transform: translateY(-50%);
    width: 318px; height: 106px; border-radius: 10px;
    background: rgba(4, 7, 11, .86);
    border: 1px solid rgba(255, 212, 121, .32);
    border-left: 5px solid #ffd479;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    box-shadow: 0 10px 26px rgba(0, 0, 0, .45), inset 0 1px 0 rgba(255, 255, 255, .06);
  }
  .code-label { font-size: 12px; letter-spacing: 4px; color: #93a4b6; font-weight: 600; }
  .code {
    margin-top: 2px; padding-left: 12px;
    font-family: "Bahnschrift", "DIN Alternate", "Consolas", "DejaVu Sans Mono", monospace;
    font-size: 64px; line-height: 1; font-weight: 700; letter-spacing: 12px;
    color: #ffd479; font-variant-numeric: tabular-nums;
    text-shadow: 0 0 22px rgba(255, 212, 121, .22);
  }

  footer {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 18px; padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, .12);
    font-size: 15px; color: #8fa0b3; letter-spacing: .5px;
  }
  footer .highlight { color: #ffd479; font-weight: 700; }
  footer .right { color: #6f8093; letter-spacing: 2px; }
</style>
</head>
<body>
<div class="card">
  <div class="grid"></div>
  <div class="content">
    <header>
      <div class="eyebrow">DELTA FORCE · DAILY INTEL CODE</div>
      <div class="title-row">
        <h1>每日密码<span class="accent">.</span></h1>
        <div class="date-block">
          <div class="date">{{ day }}</div>
          <div class="update">{{ updated_at }} 更新</div>
        </div>
      </div>
      <div class="meta">
        <span>来源：{{ source }}</span>
        <span class="dot"></span>
        <span>共 {{ entries|length }} 张地图</span>
        <span class="dot"></span>
        <span>密码门每日 0 点刷新</span>
      </div>
      <div class="rule"></div>
    </header>

    <main class="rows">
      {% for entry in entries %}
      <section class="row{% if not entry.background_url %} no-bg{% endif %}">
        {% if entry.background_url %}<div class="bg" style="background-image: url('{{ entry.background_url }}')"></div>{% endif %}
        <div class="shade"></div>
        <div class="bar"></div>
        <div class="index">MAP {{ entry.index }}</div>
        <div class="info">
          <div class="name">{{ entry.name }}</div>
          {% if entry.location %}
          <div class="location">{{ entry.location }}</div>
          {% else %}
          <div class="location empty">密码门位置以游戏内标记为准</div>
          {% endif %}
        </div>
        <div class="code-panel">
          <div class="code-label">ACCESS CODE</div>
          <div class="code">{{ entry.code }}</div>
        </div>
      </section>
      {% endfor %}
    </main>

    <footer>
      <span>每天 <span class="highlight">{{ push_time }}</span> 自动推送 ｜ 数据仅供参考，以游戏内为准</span>
      <span class="right">DELTA FORCE QQ BOT</span>
    </footer>
  </div>
</div>
</body>
</html>
