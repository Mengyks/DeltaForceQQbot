<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: #f2f3f5; }
  body {
    width: 920px;
    padding: 18px;
    font-family: "Microsoft YaHei", "Noto Sans CJK SC", "Source Han Sans SC", "WenQuanYi Zen Hei", "WenQuanYi Micro Hei", "PingFang SC", sans-serif;
    color: #20242b;
    -webkit-font-smoothing: antialiased;
  }
  .card {
    background: #fff;
    border: 1px solid #e6e8ed;
    border-radius: 24px;
    padding: 26px 30px 22px;
    box-shadow: 0 10px 28px rgba(20, 24, 32, .08);
  }
  header { text-align: center; padding-bottom: 18px; }
  h1 {
    margin: 0;
    font-size: 40px;
    line-height: 1.15;
    font-weight: 900;
    letter-spacing: 5px;
  }
  .subtitle {
    margin-top: 7px;
    font-size: 15px;
    color: #8a929e;
    letter-spacing: 1.5px;
  }
  .query-time {
    display: inline-block;
    margin-top: 8px;
    padding: 3px 12px;
    border-radius: 999px;
    background: #f4f5f7;
    color: #6b7280;
    font-size: 14px;
    letter-spacing: .5px;
  }
  .rule {
    height: 2px;
    margin: 16px 0 0;
    background: linear-gradient(90deg, transparent, #dfe2e8 18%, #dfe2e8 82%, transparent);
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: #e8eaee;
    border: 1px solid #e8eaee;
    border-radius: 18px;
    overflow: hidden;
    margin-top: 18px;
  }
  .cell {
    background: #fff;
    padding: 18px 24px 20px;
    min-height: 290px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .cell.error { background: #fafbfc; }
  .station {
    width: 100%;
    font-size: 23px;
    font-weight: 800;
    letter-spacing: 1px;
    color: #2a2f38;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .station::before {
    content: "";
    width: 5px;
    height: 20px;
    border-radius: 3px;
    background: #c7ccd4;
  }
  .figure {
    margin-top: 14px;
    width: 152px;
    height: 152px;
    border: 4px solid #7a8794;
    border-radius: 20px;
    background: linear-gradient(180deg, #fbfcfe, #f2f4f7);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .figure img {
    display: block;
    max-width: 124px;
    max-height: 124px;
    object-fit: contain;
  }
  .placeholder {
    font-size: 48px;
    font-weight: 800;
    color: #b3bac4;
  }
  .item-name {
    margin-top: 12px;
    min-height: 52px;
    max-width: 100%;
    font-size: 21px;
    font-weight: 700;
    line-height: 1.28;
    text-align: center;
    color: #20242b;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .cell.error .item-name { color: #9aa1ac; }
  .profits {
    width: 100%;
    margin-top: 10px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .metric { text-align: center; }
  .metric-label {
    font-size: 13px;
    color: #9299a4;
    letter-spacing: 1px;
  }
  .metric-value {
    margin-top: 3px;
    font-size: 25px;
    font-weight: 800;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }
  .metric-value.pos { color: #12805c; }
  .metric-value.neg { color: #d33a3a; }
  .metric-value.empty { color: #b3bac4; }
  footer {
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px solid #eef0f3;
    text-align: center;
    font-size: 13px;
    color: #9aa1ac;
    letter-spacing: .5px;
  }
</style>
</head>
<body>
<div class="card">
  <header>
    <h1>{{ title }}</h1>
    <div class="subtitle">{{ subtitle }}</div>
    <div class="query-time">查询时间：{{ query_time }}</div>
    <div class="rule"></div>
  </header>

  <div class="grid">
    {% for item in items %}
    <section class="cell{% if item.error %} error{% endif %}">
      <div class="station">{{ item.station }}</div>
      <div class="figure" style="border-color: {{ item.border_color }}">
        {% if item.image_url %}
        <img src="{{ item.image_url }}" alt="{{ item.item_name }}">
        {% else %}
        <div class="placeholder">{{ item.item_name[:1] if not item.error else "!" }}</div>
        {% endif %}
      </div>
      <div class="item-name">{{ item.item_name }}</div>
      <div class="profits">
        <div class="metric">
          <div class="metric-label">单次利润</div>
          <div class="metric-value{% if item.error %} empty{% elif item.positive %} pos{% else %} neg{% endif %}">{{ item.profit_text }}</div>
        </div>
        <div class="metric">
          <div class="metric-label">每小时利润</div>
          <div class="metric-value{% if item.error %} empty{% elif item.positive %} pos{% else %} neg{% endif %}">{{ item.hourly_text }}</div>
        </div>
      </div>
    </section>
    {% endfor %}
  </div>

  <footer>{{ source_note }}</footer>
</div>
</body>
</html>
