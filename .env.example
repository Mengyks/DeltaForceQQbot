# ============================================================
# 复制为 .env 后填写。.env 已被 .gitignore 排除，不要提交。
# ============================================================

# ----- 三角洲数据帝开放平台（必填）-----
# 在 https://orzice.com/work/ 开通服务后复制 token
# 平台要求：token 只在服务器后台使用，且所有请求必须缓存
ORZICE_TOKEN=
ORZICE_BASE_URL=https://orzice.com/workApi
ORZICE_TIMEOUT=10
# 每日资源次数上限，超过后本地熔断并告警（防止额度失控）
ORZICE_DAILY_QUOTA=2000

# ----- 缓存时长（秒）-----
# 卡战备方案缓存 4 小时：战备价格 4 小时内变化不大，缓存期内同样的查询不再调用数据帝
CACHE_TTL_TIER=14400
# DIY 自定义凑战备缓存（该功能当前关闭）
CACHE_TTL_DIY=3600

# ----- 功能开关 -----
# 凑战备（DIY）每次请求消耗 10 次资源，成本高，暂时关闭
CUSTOM_ENABLED=false

# ----- 限流（每分钟次数）-----
RATE_LIMIT_USER=2
RATE_LIMIT_GROUP=10
# 调试用群号，白名单内不做限流（英文逗号分隔），例如 123456,789012
DEBUG_GROUPS=

# ----- 群聊机器人（v2）-----
# 总开关；关闭时不影响卡战备。CHAT_GROUPS 为空也会保持关闭。
CHAT_ENABLED=false
# 只在这些群聊天（英文/中文逗号分隔）；必须同时 CHAT_ENABLED=true
CHAT_GROUPS=
# 群里叫机器人的名字/别名，逗号分隔（@、引用机器人本身也会触发）
CHAT_ALIASES=
# 可选：需要忽略的其他机器人/账号 QQ，逗号分隔
CHAT_IGNORE_QQ=

# LLM（OpenAI 兼容接口）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=60
LLM_MAX_OUTPUT_TOKENS=800

# 上下文与节奏（一般不用改）
CHAT_PERSONA_FILE=config/persona.md
CHAT_MAX_CONTEXT_CHARS=6000
CHAT_MAX_INPUT_CHARS=2000
CHAT_HISTORY_TTL_DAYS=7
CHAT_FOLLOWUP_WINDOW=180
CHAT_FOLLOWUP_MAX_REPLIES=3
CHAT_COOLDOWN=20
# 没有 @/窗口时是否也主动参与群聊；默认关闭，需要更话痨时设为 true
CHAT_AMBIENT_ENABLED=false
CHAT_AMBIENT_COOLDOWN=30
CHAT_AMBIENT_MIN_CHARS=2
CHAT_RATE_USER=3
CHAT_RATE_GROUP=20
CHAT_DAILY_TOKEN_BUDGET=200000
CHAT_VISION_ENABLED=true
CHAT_IMAGE_MAX_BYTES=8388608
CHAT_MAX_IMAGES_PER_MESSAGE=4

# 本地表情包（LLM 通过 send_meme 工具选择分类；图片目录不入库）
CHAT_MEME_ENABLED=true
CHAT_MEME_DIR=assets/memes
CHAT_MEME_COOLDOWN=30
CHAT_MEME_MAX_PER_10MIN=5
CHAT_MEME_MAX_BYTES=8388608
CHAT_MEME_RECENT_EXCLUDE=8

# ----- 掉线监控 -----
# 收到掉线/恢复通知的管理员 QQ（英文逗号分隔）。QQ 掉线时机器人无法通过 QQ 通知自己，
# 所以「恢复」通知会在重连后发出；要「掉线即通知」需配置下面的 webhook。
ALERT_QQ=
# 可选外部告警通道：填地址后，掉线瞬间/被下线/恢复都会推送
# 格式支持：json（通用 {"title","text"}）、serverchan、feishu、dingtalk
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=json
# 离线不超过这个秒数不通知（避免网络抖动误报）
ALERT_MIN_DOWNTIME=60

# ----- NoneBot / NapCat 连接 -----
DRIVER=~fastapi+~httpx+~websockets
HOST=127.0.0.1
# 注意：本机 8080 常被其他开发服务占用，这里用 8099；NapCat 的反向 WS 地址要与此一致
PORT=8099
# 与 NapCat 反向 WS 配置保持一致；留空表示不校验
ONEBOT_ACCESS_TOKEN=
# NoneBot 超级用户（JSON 列表）；只有这里的人能执行 @机器人 上下文清理
# 例：SUPERUSERS=["123456789"]（多个：["123456789","987654321"]）
SUPERUSERS=[]
LOG_LEVEL=INFO
